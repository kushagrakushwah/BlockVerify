# Environment Variables — BlockVerify
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file

# Your Infura Project ID (needed for Sepolia testnet deploy in Week 15)
INFURA_PROJECT_ID=your_infura_project_id_here

# Your wallet private key for Sepolia deployment (Week 15)
# DO NOT USE YOUR MAIN WALLET — use a burner wallet with testnet ETH only
DEPLOYER_PRIVATE_KEY=your_private_key_here
